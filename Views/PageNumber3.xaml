<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Views.PageNumber3"
             Title="PageNumber3">
    <VerticalStackLayout>
        <Slider
            x:Name="sliderAge"
            WidthRequest="350"
            Maximum="120"
            Minimum="0"
            ValueChanged="ShowAge"
            ></Slider>
        <Label
            x:Name="TextAge"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>
        <FlexLayout x:Name="CandelHolder" Wrap="Wrap">
        </FlexLayout>
    </VerticalStackLayout>
</ContentPage>