<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.Views.NiggerNum2"
             Title="SecondPage">
    <Grid RowDefinitions="*,*" Padding="30" >
        <VerticalStackLayout Grid.Row="0" BackgroundColor="Aqua">
            <Label x:Name="ResultLabel"
               VerticalOptions="Start"
               Text="the answer will be shown here"
               FontSize="24"
               HorizontalOptions="Center" />
            <FlexLayout  x:Name="candleHolder" JustifyContent="SpaceAround" Wrap="Wrap">
            </FlexLayout>
            
        </VerticalStackLayout>
        

        <HorizontalStackLayout
            
             Grid.Row="1"
            VerticalOptions="End"
            HorizontalOptions="Center"
            Spacing="10"
            Margin="0,100,0,0">

        <Label Text="name:"
            VerticalOptions="Center"/>

        <Entry x:Name="NameEntry"
            WidthRequest="100"
               Placeholder="name"/>

         <Label Text="age:"
           VerticalOptions="Center"/>

        <Entry x:Name="AgeEntry"
           WidthRequest="60"
           Placeholder="age"
           Keyboard="Numeric"/>

            <Button Text="press"
            Clicked="Button_Click"/>

        </HorizontalStackLayout>
    </Grid>
</ContentPage>